              "name": "Get Event by ID — Found [Step 5+]",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{gateway_url}}/events/evt-001",
                  "host": ["{{gateway_url}}"],
                  "path": ["events", "evt-001"]
                },
                "description": "Available: Step 5+.\n\nRetrieves evt-001 submitted earlier. Expected: 200 OK with the full event object."
              },
              "response": [],
