                      "    pm.expect(json.type).to.equal('CREDIT');",
                      "    pm.expect(json.amount).to.equal(150);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Get Event by ID — Not Found [Step 5+]",
              "request": {
                "method": "GET",
