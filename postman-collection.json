    {
      "name": "Account Service",
      "description": "All Account Service endpoints. Internal — called only by the Event Gateway in production.",
      "item": [
        {
          "name": "POST /accounts/{accountId}/transactions",
          "description": "Available: Step 6+.\n\nInternal endpoint. In production this is called by the Gateway only.\nThese requests call the Account Service directly to test its logic in isolation.",
          "item": [
            {
              "name": "Apply CREDIT Transaction (evt-001) [Step 6+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"transactionId\": \"evt-001\",\n    \"type\": \"CREDIT\",\n    \"amount\": 150.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-15T14:02:11Z\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{account_service_url}}/accounts/{{test_account_id}}/transactions",
                  "host": ["{{account_service_url}}"],
                  "path": ["accounts", "{{test_account_id}}", "transactions"]
                },
                "description": "Available: Step 6+.\n\nApplies a CREDIT of 150.00 to acct-123. Account is created automatically on the first transaction.\nExpected: 201 Created, newBalance = 150.00"
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('Response has transactionId and newBalance', function () {",
                      "    var json = pm.response.json();",
                      "    pm.expect(json.transactionId).to.equal('evt-001');",
                      "    pm.expect(json.newBalance).to.equal(150);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Apply DEBIT Transaction (evt-002) [Step 6+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"transactionId\": \"evt-002\",\n    \"type\": \"DEBIT\",\n    \"amount\": 50.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-16T09:30:00Z\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{account_service_url}}/accounts/{{test_account_id}}/transactions",
                  "host": ["{{account_service_url}}"],
                  "path": ["accounts", "{{test_account_id}}", "transactions"]
                },
                "description": "Available: Step 6+.\n\nApplies a DEBIT of 50.00 after the CREDIT above.\nExpected: 201 Created, newBalance = 100.00"
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('newBalance is 100 after CREDIT 150 - DEBIT 50', function () {",
                      "    pm.expect(pm.response.json().newBalance).to.equal(100);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Duplicate Transaction — Same transactionId (evt-001) [Step 8+]",
              "request": {
