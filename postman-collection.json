    {
      "name": "Event Gateway",
      "description": "All Event Gateway endpoints. Organised into sub-folders by route.",
      "item": [
        {
          "name": "POST /events — Event Submission",
          "description": "Available: Step 5 onwards (Step 4 for validation errors).\n\nSubmit the requests in order to build up test data:\n  1. Submit CREDIT evt-001 (timestamp: May 15)\n  2. Submit DEBIT  evt-002 (timestamp: May 16)\n  3. Submit CREDIT evt-003 (timestamp: May 10 — earliest, submitted LAST)\nThen use the GET /events?account= request to confirm out-of-order sorting.",
          "item": [
            {
              "name": "Submit CREDIT Event (evt-001) [Step 5+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"eventId\": \"evt-001\",\n    \"accountId\": \"{{test_account_id}}\",\n    \"type\": \"CREDIT\",\n    \"amount\": 150.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-15T14:02:11Z\",\n    \"metadata\": {\n        \"source\": \"mainframe-batch\",\n        \"batchId\": \"B-9042\"\n    }\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{gateway_url}}/events",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"]
                },
                "description": "Available: Step 5+. Full Gateway → Account Service flow: Step 7+.\n\nSubmits the first event. Expected response: 201 Created.\nAfter Step 7 (real Account Service integration), status in the response body should be PROCESSED.\nBefore Step 7 (stubbed client), status will be PROCESSED with a hardcoded balance."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('Response contains eventId', function () {",
                      "    var json = pm.response.json();",
                      "    pm.expect(json.eventId).to.equal('evt-001');",
                      "});",
                      "",
                      "pm.test('Response contains accountId', function () {",
                      "    var json = pm.response.json();",
                      "    pm.expect(json.accountId).to.equal(pm.collectionVariables.get('test_account_id'));",
                      "});",
                      "",
                      "pm.test('Type is CREDIT', function () {",
                      "    pm.expect(pm.response.json().type).to.equal('CREDIT');",
                      "});",
                      "",
                      "pm.test('Status is PROCESSED', function () {",
                      "    pm.expect(pm.response.json().status).to.equal('PROCESSED');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Submit DEBIT Event (evt-002) [Step 5+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"eventId\": \"evt-002\",\n    \"accountId\": \"{{test_account_id}}\",\n    \"type\": \"DEBIT\",\n    \"amount\": 50.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-16T09:30:00Z\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{gateway_url}}/events",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"]
                },
                "description": "Available: Step 5+.\n\nSubmits a DEBIT event with no metadata field. Expected response: 201 Created.\nmetadata should be absent from the response (null fields omitted per Jackson config)."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('Type is DEBIT', function () {",
                      "    pm.expect(pm.response.json().type).to.equal('DEBIT');",
                      "});",
                      "",
                      "pm.test('metadata is absent (null fields omitted)', function () {",
                      "    pm.expect(pm.response.json()).to.not.have.property('metadata');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Submit Out-of-Order Event (evt-003) [Step 5+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"eventId\": \"evt-003\",\n    \"accountId\": \"{{test_account_id}}\",\n    \"type\": \"CREDIT\",\n    \"amount\": 200.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-10T08:00:00Z\",\n    \"metadata\": {\n        \"source\": \"legacy-system\",\n        \"note\": \"arrived late\"\n    }\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{gateway_url}}/events",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"]
                },
                "description": "Available: Step 5+.\n\nThis event is submitted THIRD but has the EARLIEST eventTimestamp (2026-05-10).\nWhen you call GET /events?account= after this, the listing must return events in\ntimestamp order: evt-003 (May 10) → evt-001 (May 15) → evt-002 (May 16).\n\nExpected balance after all three events:\n  CREDIT 150 + CREDIT 200 - DEBIT 50 = 300.00 (regardless of arrival order)"
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('eventTimestamp is May 10 (earlier than evt-001)', function () {",
                      "    var ts = pm.response.json().eventTimestamp;",
                      "    pm.expect(ts).to.include('2026-05-10');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Duplicate Submission — Same eventId (evt-001) [Step 8+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"eventId\": \"evt-001\",\n    \"accountId\": \"{{test_account_id}}\",\n    \"type\": \"CREDIT\",\n    \"amount\": 150.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-15T14:02:11Z\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{gateway_url}}/events",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"]
                },
                "description": "Available: Step 8+.\n\nExact same eventId as the first CREDIT submission. The Gateway detects the duplicate\nbefore calling the Account Service and returns the original event with 200 OK.\n\nKey difference from the first submission:\n  First submission  → 201 Created  (new event)\n  This submission   → 200 OK       (original event returned, no duplicate)\n\nThe account balance must remain unchanged after this request."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200 OK (not 201 — duplicate detected)', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Original event is returned unchanged', function () {",
                      "    var json = pm.response.json();",
                      "    pm.expect(json.eventId).to.equal('evt-001');",
                      "    pm.expect(json.type).to.equal('CREDIT');",
                      "    pm.expect(json.amount).to.equal(150);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Validation — Missing eventId [Step 4+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"accountId\": \"{{test_account_id}}\",\n    \"type\": \"CREDIT\",\n    \"amount\": 100.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-15T14:02:11Z\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{gateway_url}}/events",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"]
                },
                "description": "Available: Step 4+.\n\nMissing required field: eventId. Expected: 400 Bad Request with a message identifying the missing field."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 400 Bad Request', function () {",
                      "    pm.response.to.have.status(400);",
                      "});",
                      "",
                      "pm.test('Error message identifies missing field', function () {",
                      "    var json = pm.response.json();",
                      "    pm.expect(json).to.have.property('error');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Validation — Invalid Event Type [Step 4+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"eventId\": \"evt-bad-type\",\n    \"accountId\": \"{{test_account_id}}\",\n    \"type\": \"TRANSFER\",\n    \"amount\": 100.00,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-15T14:02:11Z\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{gateway_url}}/events",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"]
                },
                "description": "Available: Step 4+.\n\ntype must be 'CREDIT' or 'DEBIT'. 'TRANSFER' is invalid.\nExpected: 400 Bad Request."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 400 Bad Request', function () {",
                      "    pm.response.to.have.status(400);",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Validation — Zero Amount [Step 4+]",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"eventId\": \"evt-bad-amount\",\n    \"accountId\": \"{{test_account_id}}\",\n    \"type\": \"CREDIT\",\n    \"amount\": 0,\n    \"currency\": \"USD\",\n    \"eventTimestamp\": \"2026-05-15T14:02:11Z\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{gateway_url}}/events",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"]
                },
                "description": "Available: Step 4+.\n\namount must be greater than 0. Zero is invalid.\nExpected: 400 Bad Request."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 400 Bad Request', function () {",
                      "    pm.response.to.have.status(400);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "GET /events — Queries",
          "description": "Available: Step 5+.\n\nRead endpoints are served entirely from the Gateway's local H2 database.\nThey remain functional even when the Account Service is unavailable (Steps 10+).",
          "item": [
