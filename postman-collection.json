              ]
            },
            {
              "name": "List Events for Account — Out-of-Order Sorting [Step 5+]",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{gateway_url}}/events?account={{test_account_id}}",
                  "host": ["{{gateway_url}}"],
                  "path": ["events"],
                  "query": [{ "key": "account", "value": "{{test_account_id}}" }]
                },
                "description": "Available: Step 5+.\n\nRun this AFTER submitting evt-001, evt-002, and evt-003 in order.\n\nExpected order in response (sorted by eventTimestamp ASC, not by arrival):\n  [0] evt-003 — 2026-05-10T08:00:00Z  (submitted 3rd, earliest timestamp)\n  [1] evt-001 — 2026-05-15T14:02:11Z  (submitted 1st)\n  [2] evt-002 — 2026-05-16T09:30:00Z  (submitted 2nd)\n\nIf out-of-order handling is correct, evt-003 appears first despite arriving last."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200 OK', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Response is an array', function () {",
                      "    pm.expect(pm.response.json()).to.be.an('array');",
                      "});",
                      "",
                      "pm.test('Events are sorted by eventTimestamp ASC (out-of-order proof)', function () {",
                      "    var events = pm.response.json();",
                      "    if (events.length >= 3) {",
                      "        pm.expect(events[0].eventId).to.equal('evt-003');",
                      "        pm.expect(events[1].eventId).to.equal('evt-001');",
                      "        pm.expect(events[2].eventId).to.equal('evt-002');",
                      "    }",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
