                  "raw": "{{gateway_url}}/events/evt-does-not-exist",
                  "host": ["{{gateway_url}}"],
                  "path": ["events", "evt-does-not-exist"]
                },
                "description": "Available: Step 5+.\n\nRequests an eventId that was never submitted. Expected: 404 Not Found."
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
