<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Inherits Spring Boot dependency management and plugin configuration
        from the parent POM.
    -->
    <parent>
        <groupId>com.eventledger</groupId>
        <artifactId>event-ledger</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>event-gateway</artifactId>
    <name>Event Gateway</name>
    <description>Public-facing API gateway — receives events, enforces idempotency, calls Account Service</description>

    <dependencies>

        <!-- REST API support: embedded Tomcat, Jackson JSON serialization, Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Bean Validation (JSR-380) via Hibernate Validator.
            Not bundled with spring-boot-starter-web in Spring Boot 3.x — must be declared
            explicitly. Provides @NotBlank, @NotNull, @Positive, @Pattern, @Size, @Valid,
            MethodArgumentNotValidException, and ConstraintViolationException.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA/Hibernate ORM for mapping Java entities to H2 tables -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            H2 in-memory database. Scoped to runtime because application code
            uses JPA abstractions and never references H2 classes directly.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Resilience4j Spring Boot 3 starter — provides @CircuitBreaker, @RateLimiter,
            and related annotations via AOP. Auto-configures circuit breaker instances
            declared under resilience4j.circuitbreaker.instances in application.yml.
            Version pinned in parent pom <properties> as resilience4j.version.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!--
            Spring AOP — required for Resilience4j annotations to work.
            @CircuitBreaker is implemented as an AOP around-advice. Without
            spring-aop + aspectjweaver on the classpath, the annotation is
            present but the proxy is never created and the circuit breaker
            never activates.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
            Micrometer Tracing bridge to the OpenTelemetry SDK.
            Enables distributed tracing: creates spans per request, populates the
            MDC with traceId and spanId (read by logback-spring.xml on every log line),
            and adds the W3C traceparent header to all RestTemplate calls so the
            Account Service's logs can be correlated with the Gateway's logs by traceId.
            Version managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <!--
            Spring Boot Actuator — two purposes:
            1. Prerequisite: Spring Boot's tracing auto-configuration lives in
               spring-boot-actuator-autoconfigure. Without this dependency,
               micrometer-tracing-bridge-otel is on the classpath but no
               Tracer bean or MDC propagation is set up.
            2. Enables /actuator/health and /actuator/metrics endpoints (Step 11).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Logstash Logback Encoder: formats each log line as a single JSON object.
            Automatically includes all MDC fields — traceId and spanId added by
            Micrometer Tracing appear as top-level fields in every log line.
            logback-spring.xml wires this encoder into the console appender.
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>

        <!--
            Test framework: JUnit 5, Mockito, MockMvc, Spring Boot Test utilities,
            and the embedded H2 database used during test runs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            WireMock 3.x — embedded HTTP stub server for JUnit 5.
            Used in CircuitBreakerTest and TracePropagationTest to simulate Account
            Service responses without starting the real service. WireMockExtension
            starts on a dynamic port; @DynamicPropertySource wires account-service.base-url
            to the WireMock URL before the Spring context is created.
            WireMock 3.x requires Java 17+ and is compatible with Spring Boot 3.x.
        -->
        <!--
            wiremock-standalone bundles Jetty 11 (WireMock's required HTTP server)
            inside the fat JAR, avoiding classpath conflicts with Spring Boot 3.x
            which manages Jetty 12. The standalone variant includes all WireMock
            dependencies and is the recommended artifact for Maven test classpaths.
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.9.1</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                Produces a fat JAR containing the application and all its dependencies,
                runnable with: java -jar event-gateway-1.0.0.jar
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
