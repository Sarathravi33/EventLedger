<?xml version="1.0" encoding="UTF-8"?>
<!--
    Simple Logback configuration for test execution.
    Takes precedence over logback-spring.xml so the production JSON encoder
    (which depends on Spring Boot's Logback integration being fully initialised)
    does not interfere with test context startup.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Silence noisy framework output; keep application logs for debugging -->
    <logger name="com.eventledger" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.github.tomakehurst" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
